<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Bulwark.Core\Bulwark.Core.csproj" />
    <ProjectReference Include="..\Bulwark.Engines\Bulwark.Engines.csproj" />
    <ProjectReference Include="..\Bulwark.Ai\Bulwark.Ai.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>bulwark</AssemblyName>
    <RootNamespace>Bulwark.Cli</RootNamespace>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
  </PropertyGroup>

  <!-- Release builds: dotnet publish -p:BulwarkManifestUrl=https://... with keys/bulwark-signing.pub present. -->
  <ItemGroup>
    <AssemblyMetadata Include="BulwarkManifestUrl" Value="$(BulwarkManifestUrl)" />
    <EmbeddedResource Include="../../keys/bulwark-signing.pub" LogicalName="bulwark-signing.pub" Condition="Exists('../../keys/bulwark-signing.pub')" />
  </ItemGroup>

</Project>
