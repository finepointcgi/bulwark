<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Nightjar.Core\Nightjar.Core.csproj" />
    <ProjectReference Include="..\Nightjar.Engines\Nightjar.Engines.csproj" />
    <ProjectReference Include="..\Nightjar.Ai\Nightjar.Ai.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>nightjar</AssemblyName>
    <RootNamespace>Nightjar.Cli</RootNamespace>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
  </PropertyGroup>

  <!-- Release builds: dotnet publish -p:NightjarManifestUrl=https://... with keys/nightjar-signing.pub present. -->
  <ItemGroup>
    <AssemblyMetadata Include="NightjarManifestUrl" Value="$(NightjarManifestUrl)" />
    <EmbeddedResource Include="../../keys/nightjar-signing.pub" LogicalName="nightjar-signing.pub" Condition="Exists('../../keys/nightjar-signing.pub')" />
  </ItemGroup>

</Project>
