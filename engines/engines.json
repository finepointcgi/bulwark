{
  "$comment": "Source of truth for engine versions. The release pipeline turns this into the signed manifest; the engine-watch workflow bumps \u0027tag\u0027 values (and Dockerfile pins) when upstream ships a release older than the maturity window. Values: {tag} = upstream tag, {bare} = tag without leading v, asset-sha256:NAME = digest of a release asset, tarball-sha256 = sha256 of the tag\u0027s source tarball, FROM = rewrite the Dockerfile\u0027s FROM line.",
  "engines": [
    {
      "name": "syft",
      "binary": "syft",
      "image": "docker.io/anchore/syft",
      "build": null,
      "upstream": [
        {
          "repo": "anchore/syft",
          "tag": "v1.55.0",
          "version": "{tag}",
          "dockerfile": null
        }
      ],
      "version": "v1.55.0"
    },
    {
      "name": "osv-scanner",
      "binary": "osv-scanner",
      "image": "ghcr.io/google/osv-scanner",
      "build": null,
      "upstream": [
        {
          "repo": "google/osv-scanner",
          "tag": "v2.7.0",
          "version": "{tag}",
          "dockerfile": null
        }
      ],
      "version": "v2.7.0"
    },
    {
      "name": "gitleaks",
      "binary": "gitleaks",
      "image": "ghcr.io/gitleaks/gitleaks",
      "build": null,
      "upstream": [
        {
          "repo": "gitleaks/gitleaks",
          "tag": "v8.30.1",
          "version": "{tag}",
          "dockerfile": null
        }
      ],
      "version": "v8.30.1"
    },
    {
      "name": "opengrep",
      "binary": "opengrep",
      "image": "nightjar-engines/opengrep",
      "build": "engines/opengrep",
      "upstream": [
        {
          "repo": "opengrep/opengrep",
          "tag": "v1.33.1",
          "version": "{tag}",
          "dockerfile": {
            "VERSION": "{tag}",
            "SHA256_AMD64": "asset-sha256:opengrep_manylinux_x86",
            "SHA256_ARM64": "asset-sha256:opengrep_manylinux_aarch64"
          }
        }
      ],
      "version": "v1.33.1"
    },
    {
      "name": "cppcheck",
      "binary": "cppcheck",
      "image": "nightjar-engines/cppcheck",
      "build": "engines/cppcheck",
      "upstream": [
        {
          "repo": "cppcheck-opensource/cppcheck",
          "tag": "2.22.0",
          "version": "{tag}",
          "dockerfile": {
            "VERSION": "{tag}",
            "SOURCE_SHA256": "tarball-sha256"
          }
        }
      ],
      "version": "2.22.0"
    },
    {
      "name": "lizard",
      "binary": "lizard",
      "image": "nightjar-engines/lizard",
      "build": "engines/lizard",
      "upstream": [
        {
          "repo": "terryyin/lizard",
          "tag": "1.24.3",
          "version": "{tag}",
          "dockerfile": {
            "VERSION": "{tag}",
            "SOURCE_SHA256": "tarball-sha256"
          }
        }
      ],
      "version": "1.24.3"
    },
    {
      "name": "trivy",
      "binary": "trivy",
      "image": "ghcr.io/aquasecurity/trivy",
      "build": null,
      "upstream": [
        {
          "repo": "aquasecurity/trivy",
          "tag": "v0.76.1",
          "version": "{bare}",
          "dockerfile": null
        }
      ],
      "version": "0.76.1"
    },
    {
      "name": "zap",
      "binary": "zap-baseline.py",
      "image": "docker.io/zaproxy/zap-stable",
      "build": null,
      "upstream": [
        {
          "repo": "zaproxy/zaproxy",
          "tag": "v2.17.0",
          "version": "{bare}",
          "dockerfile": null
        }
      ],
      "version": "2.17.0"
    },
    {
      "name": "nuclei",
      "binary": "nuclei",
      "image": "nightjar-engines/nuclei",
      "build": "engines/nuclei",
      "upstream": [
        {
          "repo": "projectdiscovery/nuclei",
          "tag": "v3.11.1",
          "version": "{tag}",
          "dockerfile": {
            "NUCLEI_VERSION": "{tag}"
          }
        },
        {
          "repo": "projectdiscovery/nuclei-templates",
          "tag": "v10.5.1",
          "version": null,
          "dockerfile": {
            "TEMPLATES_VERSION": "{bare}",
            "TEMPLATES_SHA256": "tarball-sha256"
          }
        }
      ],
      "version": "v3.11.1"
    }
  ]
}
