<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Nightjar.Core\Nightjar.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Rules/*.yaml" LogicalName="rules/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Dockerfiles of self-built engines, so a missing image can be built on first use. -->
  <ItemGroup>
    <EmbeddedResource Include="../../engines/*/Dockerfile;../../engines/*/requirements.txt" LogicalName="engine-images/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Deliberately vulnerable canary files: embedded as data, never compiled. -->
  <ItemGroup>
    <Compile Remove="Canary/Corpus/**" />
    <None Remove="Canary/Corpus/**" />
    <EmbeddedResource Include="Canary/Corpus/**" LogicalName="canary/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nightjar.Tests" />
  </ItemGroup>

</Project>
