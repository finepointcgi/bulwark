@page "/"
@inject ReportArchive Archive

<PageTitle>Bulwark</PageTitle>

@if (_reports.Count == 0)
{
    <div class="card">
        <h2>No scans yet</h2>
        <p class="muted">Run a scan and it will show up here:</p>
        <pre><code>bulwark scan path/to/project</code></pre>
        <p class="muted">Reports are read from <code>@Archive.Directory</code>.</p>
    </div>
}
else
{
    <div class="card table-wrap">
        <table>
            <thead>
                <tr><th>Project</th><th>Last scan</th><th>Findings</th><th>Engines</th></tr>
            </thead>
            <tbody>
                @foreach (var report in _reports)
                {
                    <tr>
                        <td><a href="/project/@ReportArchive.KeyFor(report.Project)">@report.Project</a></td>
                        <td class="muted">@report.StartedAt.ToLocalTime().ToString("g")</td>
                        <td><SeverityCounts Findings="report.Findings" /></td>
                        <td>
                            @foreach (var engine in report.Engines)
                            {
                                <span class="@(engine.Succeeded ? "ok" : "bad")" title="@engine.Error">@engine.Engine </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<ScanReport> _reports = [];

    protected override void OnInitialized() => _reports = Archive.LoadAll();
}
