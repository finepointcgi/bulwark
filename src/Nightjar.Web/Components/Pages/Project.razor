@page "/project/{Key}"
@using Nightjar.Core.Ai
@inject ReportArchive Archive
@inject ScanHistory History

<PageTitle>@(_report is null ? "Not found" : System.IO.Path.GetFileName(_report.Project)) · Nightjar</PageTitle>

@if (_report is null)
{
    <div class="card"><h2>Project not found</h2><a href="/">Back to all projects</a></div>
    return;
}

<div class="card">
    <h2 style="margin-top:0">@_report.Project</h2>
    <p class="muted">
        Scanned @_report.StartedAt.ToLocalTime().ToString("g") in @_report.Seconds.ToString("0.0")s ·
        manifest #@_report.ManifestSequence ·
        @string.Join(", ", _report.Engines.Select(e => $"{e.Engine} {e.Version}"))
    </p>
    <SeverityCounts Findings="_report.Findings" />
    @if (_report.Metrics is { Count: > 0 } metrics)
    {
        <dl class="metrics">
            @foreach (var (key, value) in metrics.OrderBy(m => m.Key, StringComparer.Ordinal))
            {
                <div><dt>@Nightjar.Core.Quality.MetricNames.Label(key)</dt><dd>@Nightjar.Core.Quality.MetricNames.Format(key, value)</dd></div>
            }
        </dl>
    }
    @if (_history.Count > 1)
    {
        <TrendChart Points="_history" />
    }
    @if (_report.Findings.Any(f => f.Assessment is not null))
    {
        <p class="counts ai-counts">
            <span class="muted">AI pen-test review:</span>
            @foreach (var group in _report.Findings.Where(f => f.Assessment is not null).GroupBy(f => f.Assessment!.Verdict).OrderByDescending(g => g.Key))
            {
                <a class="ai-badge ai-@group.Key" href="@($"/project/{Key}?ai={group.Key}")">@group.Count() @AiAssessment.Label(group.Key)</a>
            }
        </p>
    }
    @if (_report.Pentest is { } pentest)
    {
        <div class="pentest">
            <p>
                <strong>Active test</strong> authorized by @pentest.AuthorizedBy
                (<code>@pentest.AuthorizationReference</code>, valid until @pentest.AuthorizationExpires.ToLocalTime().ToString("g"))
            </p>
            <p class="muted">
                @if (pentest.AuthenticatedWithHeader is { } header) { <text>authenticated (@header header) · </text> }
                @if (pentest.OpenApi is { } spec) { <text>API scan from <code>@System.IO.Path.GetFileName(spec)</code> (@(pentest.ActiveScan ? "active" : "safe mode")) · </text> }
                @pentest.RequestsAllowed requests sent · @pentest.RequestsBlocked blocked by scope ·
                scope <code title="SHA-256 of the scope file">@pentest.ScopeSha256[..12]</code> ·
                log <code>@pentest.RequestLog</code>
            </p>
            @if (pentest.Correlations.Count > 0)
            {
                <h4 class="corr-title">Static findings checked by this test</h4>
                <ul class="correlations">
                    @foreach (var c in pentest.Correlations)
                    {
                        <li>
                            <span class="corr corr-@c.Status">@c.Status</span>
                            <strong>@c.StaticTitle</strong>
                            <span class="muted">@c.Explanation</span>
                        </li>
                    }
                </ul>
            }
            @if (pentest.Plan is { } plan)
            {
                <details>
                    <summary>Plan by @plan.PlannedBy: @string.Join(", ", plan.NucleiTags)@(plan.FocusPaths.Count > 0 ? $" · {plan.FocusPaths.Count} focus paths" : "")</summary>
                    <div class="ai-body">
                        @if (plan.Rationale is { } why) { <p>@why</p> }
                        @if (plan.FocusPaths.Count > 0) { <p>Focus: @foreach (var path in plan.FocusPaths) { <code>@path</code><text> </text> }</p> }
                        @foreach (var h in plan.Hypotheses) { <p>Tests static finding <code>@h.StaticFindingId[..Math.Min(12, h.StaticFindingId.Length)]</code>: @h.Test</p> }
                        @if (plan.Rejected.Count > 0)
                        {
                            <h4>Refused by scope or allowlist</h4>
                            <ul>@foreach (var r in plan.Rejected) { <li>@r</li> }</ul>
                        }
                    </div>
                </details>
            }
        </div>
    }
    @foreach (var failed in _report.Engines.Where(e => !e.Succeeded))
    {
        <p class="bad">@failed.Engine failed: @failed.Error</p>
    }
</div>

<div class="card">
    <form method="get" class="filters">
        <select name="severity">
            <option value="">Any severity</option>
            @foreach (var s in Enum.GetValues<Severity>().Reverse())
            {
                <option value="@s" selected="@(SeverityFilter == s.ToString())">@s+</option>
            }
        </select>
        <select name="category">
            <option value="">All categories</option>
            @foreach (var c in Enum.GetValues<FindingCategory>())
            {
                <option value="@c" selected="@(CategoryFilter == c.ToString())">@c</option>
            }
        </select>
        <select name="ai">
            <option value="">Any AI verdict</option>
            @foreach (var v in Enum.GetValues<Exploitability>().Reverse())
            {
                <option value="@v" selected="@(AiFilter == v.ToString())">@AiAssessment.Label(v)</option>
            }
            <option value="none" selected="@(AiFilter == "none")">Not reviewed</option>
        </select>
        <input name="q" value="@Query" placeholder="Search package, id, title" />
        <button type="submit">Filter</button>
        <span class="muted">@_visible.Count of @_report.Findings.Count</span>
    </form>

    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Severity</th><th>Category</th><th>Id</th><th>Finding</th><th>Fix</th><th>AI review</th><th>Engines</th></tr>
            </thead>
            <tbody>
                @foreach (var f in _visible)
                {
                    <tr>
                        <td><span class="sev sev-@f.Severity">@f.Severity.ToString().ToUpperInvariant()</span></td>
                        <td>@f.Category</td>
                        <td>
                            @if (f.References.FirstOrDefault() is { } link)
                            {
                                <a href="@link" target="_blank" rel="noopener">@f.RuleId</a>
                            }
                            else
                            {
                                @f.RuleId
                            }
                        </td>
                        <td>
                            @f.Title
                            @if (f.Location?.Path is { } path)
                            {
                                <div class="muted"><code>@path</code></div>
                            }
                            <TriageButtons @key="f.Id" Project="@_report.Project" Finding="f" />
                        </td>
                        <td>@string.Join(" / ", f.FixedVersions)</td>
                        <td class="ai-cell"><AiAssessment Assessment="f.Assessment" /></td>
                        <td class="muted">@string.Join(", ", f.Engines)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter] public string Key { get; set; } = "";
    [SupplyParameterFromQuery(Name = "severity")] public string? SeverityFilter { get; set; }
    [SupplyParameterFromQuery(Name = "category")] public string? CategoryFilter { get; set; }
    [SupplyParameterFromQuery(Name = "ai")] public string? AiFilter { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }

    private ScanReport? _report;
    private IReadOnlyList<HistoryPoint> _history = [];
    private List<Finding> _visible = [];

    protected override void OnParametersSet()
    {
        _report = Archive.LoadAll().FirstOrDefault(r => ReportArchive.KeyFor(r.Project) == Key);
        if (_report is null)
        {
            return;
        }

        _history = History.Load(_report.Project);
        IEnumerable<Finding> findings = _report.Findings;
        if (Enum.TryParse<Severity>(SeverityFilter, out var minimum))
        {
            findings = findings.Where(f => f.Severity >= minimum);
        }

        if (Enum.TryParse<FindingCategory>(CategoryFilter, out var category))
        {
            findings = findings.Where(f => f.Category == category);
        }

        if (AiFilter == "none")
        {
            findings = findings.Where(f => f.Assessment is null);
        }
        else if (Enum.TryParse<Exploitability>(AiFilter, out var verdict))
        {
            findings = findings.Where(f => f.Assessment?.Verdict == verdict);
        }

        if (!string.IsNullOrWhiteSpace(Query))
        {
            findings = findings.Where(f =>
                f.Title.Contains(Query, StringComparison.OrdinalIgnoreCase)
                || f.RuleId.Contains(Query, StringComparison.OrdinalIgnoreCase)
                || f.Aliases.Any(a => a.Contains(Query, StringComparison.OrdinalIgnoreCase))
                || (f.Package?.Name.Contains(Query, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        _visible = findings.ToList();
    }
}
